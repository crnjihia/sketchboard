{
  "name": "sketchboard-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter \"@sketchboard/*\" --parallel dev",
    "dev:web": "pnpm --filter @sketchboard/web dev",
    "dev:server": "pnpm --filter @sketchboard/server dev",
    "build": "pnpm --filter \"@sketchboard/*\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:chaos": "tsx scripts/chaos-test.ts",
    "test:load": "tsx scripts/load-test.ts",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed-demo.ts",
    "lint": "pnpm --filter \"@sketchboard/*\" exec tsc --noEmit",
    "clean": "node -e \"console.log('cleaning...')\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sketchboard/shared": "workspace:*",
    "@types/node": "^22.10.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
