// path: .env.example
# ==============================================================================
# Sketchboard Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=4000
HOST=0.0.0.0
NODE_ID=server-1
CORS_ORIGIN=*

# Distributed Redis Hot-Log & Cross-Node Pub/Sub
ENABLE_REDIS=true
REDIS_URL=redis://localhost:6379

# PostgreSQL Compacted Snapshot Persistence
ENABLE_POSTGRES=true
DATABASE_URL=postgres://postgres:sketchboard_secret@localhost:5432/sketchboard

# CRDT Snapshot Compaction Threshold
# Number of incremental hot updates in Redis before acquiring distributed lock
# and compacting a Y.Doc snapshot into PostgreSQL
COMPACTION_THRESHOLD=50

# Safaricom Daraja 2.0 M-PESA Integration
# Set MPESA_MOCK=true (default) to run with zero real credentials in local/test environments
MPESA_MOCK=true
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_SHORTCODE=174379
DARAJA_CALLBACK_URL=http://localhost:4000/api/payments/mpesa/callback

# Africa's Talking SMS Integration
# Set AFRICASTALKING_MOCK=true (default) to run with zero real credentials
AFRICASTALKING_MOCK=true
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Web Frontend (Vite)
# Leave blank to use relative Socket.io connection (proxied by NGINX)
# Or set explicitly for standalone development (e.g., http://localhost:4000)
VITE_SERVER_URL=
